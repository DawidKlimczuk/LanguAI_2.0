datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  Int       @id @default(autoincrement())
  username            String    @db.VarChar(50)
  email               String    @unique @db.VarChar(100)
  password            String    @db.VarChar(255)
  gems                Int?      @default(0)
  xp                  Int?      @default(0)
  hearts              Int?      @default(5)
  interfaceLanguage   String?   @default("pl") @map("interface_language") @db.VarChar(5)
  lessonsCompleted    Int?      @default(0) @map("lessons_completed")
  totalCorrectAnswers Int?      @default(0) @map("total_correct_answers")
  itemsBought         Int?      @default(0) @map("items_bought")
  quizStreak          Int?      @default(0) @map("quiz_streak")
  createdAt           DateTime  @default(now()) @map("created_at")
  theme               String?   @default("default") @db.VarChar(20)
  unlockedThemes      String?   @default("[\"default\"]") @map("unlocked_themes")
  skipCount           Int?      @default(0) @map("skip_count")
  lastDailyClaim      DateTime? @map("last_daily_claim")
  savedQuizLang       String?   @map("saved_quiz_lang") @db.VarChar(20)
  savedQuizProgress   Int?      @default(0) @map("saved_quiz_progress")
  avatar              String?   @default("?") @db.VarChar(50)

  userProgress        UserProgress[]
  userAchievements    UserAchievement[]

  @@map("users")
}

model UserProgress {
  id              Int     @id @default(autoincrement())
  userId          Int     @map("user_id")
  targetLanguage  String? @map("target_language") @db.VarChar(50)
  weakTopics      String? @map("weak_topics")
  correctCount    Int?    @default(0) @map("correct_count")
  wrongCount      Int?    @default(0) @map("wrong_count")
  difficultyLevel Int?    @default(1) @map("difficulty_level")
  questionHistory String? @map("question_history")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model Achievement {
  id       Int     @id @default(autoincrement())
  keyName  String? @unique @map("key_name") @db.VarChar(50)
  icon     String? @db.VarChar(20)
  titlePl  String? @map("title_pl") @db.VarChar(100)
  descPl   String? @map("desc_pl") @db.VarChar(255)
  xpReward Int?    @map("xp_reward")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  achievementId Int?     @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@map("user_achievements")
}

model ShopItem {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(50)
  cost Int?
  icon String? @db.VarChar(20)

  @@map("shop_items")
}